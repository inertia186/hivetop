{
  "name": "hivetop",
  "version": "1.10.0",
  "description": "An htop-like terminal monitor for the Hive blockchain.",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inertia186/hivetop.git"
  },
  "type": "module",
  "bin": {
    "hivetop": "./dist/cli.js"
  },
  "files": [
    "dist",
    "logo.png"
  ],
  "scripts": {
    "start": "node ./dist/cli.js",
    "dev": "node ./dist/cli.js",
    "preab:tui": "npm run build",
    "ab:tui": "node ./scripts/tui-ab.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "pretest:coverage": "npm run build",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"dist/**/*.js\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage.lcov test/*.test.mjs",
    "precoverage:overlap": "npm run build",
    "coverage:overlap": "node ./scripts/coverage-overlap.mjs",
    "prepublishOnly": "npm test",
    "build": "tsc -p tsconfig.json && node ./scripts/make-cli-executable.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@xterm/headless": "6.0.0",
    "typescript": "^5.8.0"
  }
}
